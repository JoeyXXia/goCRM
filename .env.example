# Documentation template: GVA does NOT automatically load this file.
# PowerShell: $env:GVA_CONFIG = 'config.local.yaml' (run from server/)
GVA_CONFIG=config.local.yaml
# Initializer UI values; these are placeholders, not application env overrides.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dealflow_crm_dev
MYSQL_USER=replace_with_local_user
MYSQL_PASSWORD=replace_with_local_password
# Choose a unique administrator password in the GVA initialization page.
# JWT signing key is generated by scripts/prepare-local.ps1 and by GVA initialization.
# Redis is disabled in this Day 1 baseline (use-redis/use-multipoint=false).
